{
  "name": "review-changes-marketplace",
  "private": true,
  "type": "module",
  "scripts": {
    "build:viewer": "bun run viewer/build.ts",
    "test": "claude plugin test plugins/review-changes && bun run test:viewer",
    "test:viewer": "cd viewer && bun test",
    "typecheck": "tsc -p tsconfig.plugin.json && tsc -p viewer/tsconfig.json",
    "validate": "claude plugin validate . && claude plugin validate plugins/review-changes"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@pierre/diffs": "1.5.2",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}
